# Instance PocketBase consultée à la construction et au développement.
POCKETBASE_URL=https://pb.melvyn-philippon.fr
# Origine HTTPS publique, obligatoire pour construire ; sans chemin ni paramètres.
# Peut rester vide pour le seul serveur de développement (robots bloque alors l'exploration).
SITE_URL=https://portfolio.melvyn-philippon.fr
# Adresse du pied de page Figma, à confirmer avant publication.
CONTACT_EMAIL=melvyn.philippon@outlook.com
# Réseaux du footer : renseigner les URL HTTPS des profils pour activer les liens.
# Instagram reste masqué si son URL est vide.
LINKEDIN_URL=
GITHUB_URL=
BEHANCE_URL=
INSTAGRAM_URL=
# URL HTTPS du CV publié ; le téléchargement reste désactivé si elle est vide.
CV_URL=
