---
import { Image, inferRemoteSize } from "astro:assets";
const {
  src,
  alt,
  priority = false,
  class: className,
  sizes = "(max-width: 899px) 100vw, 61vw",
  transitionName,
  widths = [480, 878, 1440],
  quality = 85,
  nativeSizing = false,
} = Astro.props;
const metadata = nativeSizing ? await inferRemoteSize(src) : null;
const responsiveWidths = metadata
  ? [...new Set([...widths.filter((width) => width <= metadata.width), metadata.width])].sort((a, b) => a - b)
  : widths;
---

<Image
  src={src}
  alt={alt}
  class={className}
  inferSize={!metadata}
  width={metadata?.width}
  height={metadata?.height}
  widths={responsiveWidths}
  sizes={sizes}
  format="webp"
  quality={quality}
  loading={priority ? "eager" : "lazy"}
  decoding={priority ? "sync" : "async"}
  fetchpriority={priority ? "high" : "auto"}
  style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
/>
