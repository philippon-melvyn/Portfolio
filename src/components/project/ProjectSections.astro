---
import ProjectImage from "../ProjectImage.astro";
const { project, gallery = [] } = Astro.props;
const fields = [
  ["recherche", "Recherche"],
  ["realisation", "Réalisation"],
  ["choix_technique", "Choix techniques"],
];
const texts = fields.filter(([field]) => project[field]?.trim());
const [lead, ...images] = gallery;
// Keep the file order; place the process notes between groups of images.
const entries = [];
let textIndex = 0;
images.forEach((src, index) => {
  entries.push({ type: "image", src, index });
  if ((index + 1) % 3 === 0 && texts[textIndex]) {
    entries.push({ type: "text", field: texts[textIndex][0], title: texts[textIndex][1] });
    textIndex += 1;
  }
});
texts.slice(textIndex).forEach(([field, title]) => entries.push({ type: "text", field, title }));
const layout = ["regular", "offset", "regular", "wide", "regular", "offset", "regular", "wide"];
---

{lead && (
  <figure class="project-lead-image m-0 h-[clamp(260px,38vw,700px)] max-h-[75svh] overflow-hidden [&_img]:block [&_img]:w-full [&_img]:h-full [&_img]:object-cover [&_img]:object-center">
    <ProjectImage src={lead} sizes="100vw" widths={[480, 960, 1440, 1920, 2560]} alt={`${project.titre} — visuel 1 sur ${gallery.length}`} />
  </figure>
)}
{entries.length > 0 && (
  <section class="project-composition p-[clamp(48px,7vw,120px)_var(--project-space)]" aria-label={`Images et démarche du projet ${project.titre}`}>
    <div class="project-image-grid grid grid-cols-3 gap-[clamp(24px,3vw,56px)] [align-items:start] min-[700px]:max-[1100px]:grid-cols-2 max-[700px]:grid-cols-[1fr] max-[700px]:gap-8">
      {entries.map((entry) => entry.type === "image" ? (
        <figure class:list={["project-gallery-image min-w-0 m-0 overflow-hidden [&_img]:block [&_img]:w-full [&_img]:h-auto [&.project-gallery-wide]:col-[span_2] [&.project-gallery-offset]:pt-[clamp(40px,7vw,120px)] max-[700px]:[&.project-gallery-wide]:col-auto max-[700px]:[&.project-gallery-offset]:pt-0 print:[&.project-gallery-offset]:pt-0", `project-gallery-${layout[entry.index % layout.length]}`]}>
          <ProjectImage
            src={entry.src}
            sizes={layout[entry.index % layout.length] === "wide" ? "(max-width: 699px) 100vw, (max-width: 1099px) 90vw, 62vw" : "(max-width: 699px) 100vw, (max-width: 1099px) 44vw, 30vw"}
            widths={[480, 960, 1440, 1920]}
            alt={`${project.titre} — visuel ${entry.index + 2} sur ${gallery.length}`}
          />
        </figure>
      ) : (
        <section class="project-process-note self-center min-w-0 p-[clamp(16px,2vw,40px)_0] text-[13px] leading-[1.8] [&_p]:max-w-[42ch] min-[1700px]:text-[15px] max-[700px]:p-[16px_0] max-[700px]:text-[14px]" aria-labelledby={`project-${entry.field}`}>
          <h2 id={`project-${entry.field}`} class="project-label text-[10px] leading-normal tracking-[.13em] uppercase text-(--project-muted) mb-4 font-medium">{entry.title}</h2>
          <p class="project-plain-text whitespace-pre-line wrap-anywhere">{project[entry.field]}</p>
        </section>
      ))}
    </div>
  </section>
)}
