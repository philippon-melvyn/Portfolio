---
import ProjectTransitions from "./ProjectTransitions.astro";
import ProjectImage from "./ProjectImage.astro";
import { imagesFor } from "../lib/pocketbase.js";
const { projects = [] } = Astro.props;
---
<ProjectTransitions />

<section class="home-project-gallery relative [color:#fafaf8] [background:#111] [&[data-horizontal-ready]_.home-project-stage]:sticky [&[data-horizontal-ready]_.home-project-stage]:top-0 [&[data-horizontal-ready]_.home-project-stage]:overflow-clip [&[data-horizontal-ready]_.home-project-stage]:[scroll-snap-type:none] [&[data-horizontal-ready]_.home-project-stage]:[background:#111] print:[&[data-horizontal-ready]]:h-auto! print:[&[data-horizontal-ready]_.home-project-stage]:static print:[&[data-horizontal-ready]_.home-project-stage]:h-auto print:[&[data-horizontal-ready]_.home-project-stage]:overflow-visible [&[data-horizontal-ready]_[data-home-project-panel]]:w-[100vw] print:[&[data-horizontal-ready]_[data-home-project-panel]]:relative print:[&[data-horizontal-ready]_[data-home-project-panel]]:[inset:auto] print:[&[data-horizontal-ready]_[data-home-project-panel]]:transform-none" data-home-projects data-project-axis="horizontal" aria-label="Réalisations et parcours">
  <div class="home-project-stage h-[100svh] overflow-x-auto overflow-y-hidden [scroll-snap-type:x_mandatory] [border:0] rounded-none [box-shadow:none] print:h-auto print:overflow-visible" data-home-project-stage tabindex="0" role="group" aria-roledescription="carrousel" aria-label="Parcourir les projets avec le défilement ou les flèches gauche et droite.">
    <ul class="home-project-track [border:0] rounded-none [box-shadow:none] relative flex w-[max-content] h-full gap-[0] m-0 p-0 [list-style:none] [[data-horizontal-ready]_&]:[will-change:transform] print:block print:w-full print:transform-none!" data-home-project-track>
      {projects.map((project) => {
        const cover = imagesFor(project, "couverture")[0];
        return (
          <li class="home-project-tile [border:0] rounded-none [box-shadow:none] [flex:0_0_auto] w-[100vw] h-full m-0 p-0 [scroll-snap-align:start] [&_>_a]:relative [&_>_a]:isolate [&_>_a]:block [&_>_a]:w-full [&_>_a]:h-full [&_>_a]:overflow-hidden [&_>_a]:[border:0] [&_>_a]:rounded-none [&_>_a]:[color:#fff] [&_>_a]:[background:#111] [&_h2]:absolute [&_h2]:z-1 [&_h2]:left-[clamp(24px,_6.5vw,_125px)] [&_h2]:max-w-[calc(100%_-_clamp(24px,_6.5vw,_125px)_-_24px)] [&_h2]:bottom-[clamp(36px,_7svh,_90px)] [&_h2]:m-0 [&_h2]:[font:500_clamp(40px,_6vw,_110px)/1.05_var(--font-sans)] [&_h2]:uppercase [&_h2]:tracking-[-.05em] [&_h2]:[overflow-wrap:anywhere] [&_h2]:[transition:transform_350ms_ease] [&_>_a:focus-visible]:[outline:none] [&_>_a:focus-visible]:[box-shadow:none] [&_>_a:focus-visible_h2]:[outline:2px_solid_currentColor] [&_>_a:focus-visible_h2]:[outline-offset:8px] [&_>_a:focus-visible_img]:[filter:brightness(1.08)] [@media((hover:_hover)_and_(pointer:_fine))]:[&_>_a:has(h2:hover)_img]:[filter:brightness(1.08)] [@media((hover:_hover)_and_(pointer:_fine))]:[&_h2:hover]:[transform:translateY(-6px)] max-[900px]:[&_h2]:text-[clamp(40px,_8vw,_72px)] motion-reduce:[&_h2]:[transition:none] motion-reduce:[&_h2:hover]:transform-none print:w-full print:h-[70vh] print:[break-inside:avoid]" data-home-project-panel>
            <a href={`/projets/${project.slug}/`} aria-labelledby={`home-project-${project.slug}`}>
              <div class="home-project-image [border:0] rounded-none [box-shadow:none] absolute inset-0 grid place-items-center overflow-hidden [background:#111] [&_img]:[border:0] [&_img]:rounded-none [&_img]:[box-shadow:none] after:[content:''] after:absolute after:inset-0 after:[background:linear-gradient(180deg,_transparent_45%,_#0002_65%,_#000a_100%)] after:pointer-events-none [&_img]:block [&_img]:w-full [&_img]:h-full [&_img]:object-cover [&_img]:[transition:filter_700ms_ease] motion-reduce:[&_img]:[transition:none]">
                {cover && <ProjectImage src={cover} alt="" sizes="100vw" nativeSizing widths={[480, 960, 1440, 1920, 2560, 2880]} quality={95} transitionName={`project-cover-${project.slug}`} />}
              </div>
              <h2 id={`home-project-${project.slug}`}>{project.titre}</h2>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
