---
import ArrowLink from "./ArrowLink.astro";
import ProjectImage from "./ProjectImage.astro";
import { imagesFor } from "../lib/pocketbase.js";
import { projectDomains } from "../lib/project-browser.js";
import "../styles/project-navigation.css";
const { projects = [] } = Astro.props;
---

<section
  class="home-project-gallery"
  data-project-browser
  data-project-axis="horizontal"
  data-project-storage-key="portfolio-home-projects"
  aria-label="Une sélection de mes projets"
  aria-roledescription="carrousel"
>
  <div class="home-project-heading">
    <h2 class="heading-medium">Mes projets</h2>
    <ArrowLink href="/projets/" label="Tous les projets" light />
  </div>
  <p
    class="sr-only"
    data-project-status
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></p>
  <div
    class="home-project-viewport"
    data-project-viewport
    tabindex="0"
    aria-label="Projets. Faites glisser horizontalement ou utilisez les flèches gauche et droite."
  >
    {projects.length ? (
      <ul class="home-project-track">
        {projects.map((project, index) => {
          const cover = imagesFor(project, "couverture")[0];
          return (
            <li
              class="home-project-tile"
              data-project-tile
              data-project-slug={project.slug}
              data-project-domains={JSON.stringify(
                projectDomains(project.domaines),
              )}
            >
              <a href={`/projets/${project.slug}/`} data-project-link>
                <div class="home-project-image">
                  {cover && (
                    <ProjectImage
                      src={cover}
                      alt={project.couverture_alt || project.titre}
                      sizes="(max-width: 599px) 76vw, 30vw"
                      transitionName={`project-cover-${project.slug}`}
                    />
                  )}
                </div>
                <div class="home-project-caption">
                  <h3 data-project-title>{project.titre}</h3>
                  <p>{projectDomains(project.domaines).join(" · ")}</p>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="home-project-empty">
        Mes réalisations seront bientôt présentées ici.
      </p>
    )}
  </div>
  <div class="home-project-controls" data-project-controls hidden>
    <span data-project-position aria-hidden="true"></span>
    <div>
      <button type="button" data-project-previous>
        Précédent
      </button>
      <button type="button" data-project-next>
        Suivant
      </button>
      <button type="button" data-project-autoplay aria-pressed="false">
        Pause
      </button>
    </div>
  </div>
</section>
<script>
  import "../scripts/project-browser.js";
</script>
<style>
  .home-project-gallery {
    padding-block: 56px 24px;
    background: #101113;
    color: var(--color-paper);
  }
  .home-project-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-inline: clamp(24px, 3.472vw, 80px);
    margin-bottom: 36px;
  }
  .home-project-viewport {
    height: clamp(440px, 72svh, 760px);
    overflow-x: auto;
    overflow-y: hidden;
    padding: 20px clamp(24px, 3.472vw, 80px) 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .home-project-viewport::-webkit-scrollbar {
    display: none;
  }
  .home-project-viewport[data-animated-scroll="true"] {
    scroll-snap-type: none;
    scroll-behavior: auto;
  }
  .home-project-track {
    position: relative;
    display: flex;
    gap: 30px;
    width: max-content;
    min-width: 100%;
    height: 100%;
  }
  .home-project-tile {
    flex: 0 0 auto;
    width: clamp(240px, 30vw, 450px);
    height: 100%;
    scroll-snap-align: start;
    transition: transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .home-project-tile > a {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    height: 100%;
  }
  .home-project-image {
    overflow: hidden;
    min-height: 0;
    background: #242426;
  }
  .home-project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .home-project-caption {
    padding-top: 18px;
  }
  .home-project-caption h3 {
    font: 500 24px/1.2 var(--font-sans);
    letter-spacing: -0.035em;
  }
  .home-project-caption p {
    margin-top: 10px;
    color: #aaa8a4;
    font:
      500 10px/1.6 ui-monospace,
      Consolas,
      monospace;
    text-transform: uppercase;
  }
  .home-project-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 16px clamp(24px, 3.472vw, 80px) 0;
    color: #aaa8a4;
    font-size: 11px;
  }
  .home-project-controls > div {
    display: flex;
    gap: 20px;
  }
  .home-project-controls button {
    min-height: 44px;
    font-size: 10px;
    text-transform: uppercase;
    border-bottom: 1px solid #fafaf84d;
  }
  .home-project-controls button:hover {
    color: white;
  }
  .home-project-empty {
    padding: 40px 0;
    font-size: 14px;
  }
  .home-project-gallery.is-project-leaving {
    opacity: 0;
    transition: opacity 240ms;
  }
  @media (hover: hover) and (pointer: fine) {
    .home-project-tile:hover {
      transform: translateY(-5px) scale(1.025);
    }
    .home-project-tile:hover img {
      transform: scale(1.08);
    }
  }
  @media (max-width: 599px) {
    .home-project-gallery {
      padding-top: 36px;
    }
    .home-project-heading {
      align-items: start;
    }
    .home-project-heading .heading-medium {
      font-size: 30px;
    }
    .home-project-viewport {
      height: 580px;
      max-height: 78svh;
    }
    .home-project-tile {
      width: 76vw;
    }
    .home-project-track {
      gap: 20px;
    }
    .home-project-caption h3 {
      font-size: 20px;
    }
    .home-project-caption p {
      font-size: 9px;
    }
    .home-project-controls > div {
      gap: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-project-tile,
    .home-project-image img,
    .home-project-gallery.is-project-leaving {
      transition: none;
    }
    .home-project-tile:hover,
    .home-project-tile:hover img {
      transform: none;
    }
  }
</style>
