---
import { site } from "../data/site.js";
---

<footer class="column-footer [background:#101113] [color:var(--color-paper)] p-[44px_clamp(24px,_3.472vw,_80px)_24px] [&_h2]:[font-family:ui-monospace,_'Cascadia_Code',_Consolas,_monospace] [&_h2]:text-[12px] [&_h2]:font-medium [&_h2]:leading-[1.65] [&_h2]:tracking-[0.025em] [&_h2]:uppercase [&_li]:[font-family:ui-monospace,_'Cascadia_Code',_Consolas,_monospace] [&_li]:text-[12px] [&_li]:font-medium [&_li]:leading-[1.65] [&_li]:tracking-[0.025em] [&_li]:uppercase [&_h2]:mb-8 [&_h2]:[color:var(--color-paper)] [&_.column-footer-name]:pl-3.5 [&_.column-footer-name]:[border-left:2px_solid_var(--color-brick)] [&_.column-footer-name]:[font:600_28px/1.05_var(--font-display)] [&_.column-footer-name]:tracking-[0.02em] [&_ul]:[list-style:none] [&_ul]:m-0 [&_ul]:p-0 [&_li]:[color:#b3b2b0] [&_a]:inline-flex [&_a]:items-center [&_a]:min-h-9 [&_a]:max-w-full [&_a]:[overflow-wrap:anywhere] [&_a]:[transition:color_160ms_ease] [&_a:hover]:[color:white] [&_a:hover]:[text-decoration:underline] [&_a:hover]:[text-underline-offset:5px] max-[1101px]:[&_h2]:mb-5 max-[600px]:pt-8 max-[600px]:[&_h2]:text-[11px] max-[600px]:[&_li]:text-[11px] max-[600px]:[&_a]:min-h-11 motion-reduce:[&_a]:[transition:none]" id="contact" aria-label="Pied de page">
  <div class="column-footer-inner max-w-400 mx-auto">
    <div class="column-footer-grid grid [grid-template-columns:1.45fr_repeat(4,_minmax(0,_1fr))] [&_>_*]:min-w-0 [&_>_*]:min-h-67.5 [&_>_*]:p-[20px_clamp(20px,_2.3vw,_44px)_28px] [&_>_*]:[border-left:1px_solid_#fafaf826] [&_>_:first-child]:pl-0 [&_>_:first-child]:[border-left:0] [&_>_:last-child]:pr-0 max-[1101px]:[grid-template-columns:repeat(2,_minmax(0,_1fr))] max-[1101px]:[&_>_*]:min-h-0 max-[1101px]:[&_>_*]:p-[28px_24px] max-[1101px]:[&_>_*]:[border-top:1px_solid_#fafaf826] max-[1101px]:[&_>_:first-child]:[grid-column:1_/_-1] max-[1101px]:[&_>_:first-child]:p-[0_0_32px] max-[1101px]:[&_>_:first-child]:[border-top:0] max-[1101px]:[&_>_:nth-child(even)]:[border-left:0] max-[1101px]:[&_>_:nth-child(even)]:pl-0 max-[1101px]:[&_>_:nth-child(odd):not(:first-child)]:pr-0 max-[600px]:[&_>_*]:p-[24px_16px]">
      <div class="column-footer-identity">
        <h2 class="column-footer-name [&_>_span]:block">
          <span>Melvyn</span>
          <span>Philippon</span>
        </h2>
        <a class="column-footer-email [font-family:ui-monospace,_'Cascadia_Code',_Consolas,_monospace] text-[12px] font-medium leading-[1.65] tracking-[0.025em] uppercase [color:#b3b2b0] min-h-11 max-[600px]:text-[11px]" href={`mailto:${site.email}`}>
          {site.email}
        </a>
        {site.socials.length > 0 && (
          <ul class="column-footer-socials flex flex-wrap gap-[4px_18px] mt-7! [&_a]:text-[10px]">
            {site.socials.map((social) => (
              <li>
                <a href={social.url} target="_blank" rel="noopener noreferrer">
                  {social.name}
                  <span class="sr-only"> (nouvel onglet)</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      <nav aria-label="Pages du portfolio">
        <h2>À découvrir</h2>
        <ul>
          <li>
            <a href="/projets/">Mes projets</a>
          </li>
          <li>
            <a href="/a-propos/">À propos</a>
          </li>
        </ul>
      </nav>
      <div>
        <h2>Mes domaines</h2>
        <ul>
          <li>Identité visuelle</li>
          <li>Design d’interfaces</li>
          <li>Développement web</li>
        </ul>
      </div>
      <div>
        <h2>Mon parcours</h2>
        <ul>
          <li>BUT MMI</li>
          <li>Création numérique</li>
          <li>Montbéliard</li>
        </ul>
      </div>
      <div>
        <h2>Échangeons</h2>
        <ul>
          <li>
            <a href="/contact/">Me contacter</a>
          </li>
          <li>
            {site.phone}
          </li>
          <li>{site.location}</li>
        </ul>
      </div>
    </div>
    <div class="column-footer-bottom [font-family:ui-monospace,_'Cascadia_Code',_Consolas,_monospace] font-medium leading-[1.65] tracking-[0.025em] uppercase flex items-center justify-between flex-wrap gap-[12px_24px] [border-top:1px_solid_#fafaf826] pt-6 [color:#a5a4a2] text-[10px] [&_>_div]:flex [&_>_div]:items-center [&_>_div]:gap-3 [&_a]:min-h-11 max-[600px]:flex-col max-[600px]:items-start max-[600px]:gap-1 max-[600px]:text-[9px] max-[600px]:[&_>_div]:gap-2 max-[600px]:[&_>_div]:flex-wrap">
      <p>
        © {new Date().getFullYear()} {site.name}
      </p>
      <div>
        <a href="/mentions-legales/">Mentions légales</a>
        <span aria-hidden="true"> / </span>
        <a href="/confidentialite/">Confidentialité</a>
      </div>
    </div>
  </div>
</footer>
