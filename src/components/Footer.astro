---
import { site } from "../data/site.js";
---

<footer class="column-footer [background:#101113] text-paper p-[44px_clamp(24px,3.472vw,80px)_24px] [&_h2]:font-[ui-monospace,'Cascadia_Code',Consolas,monospace] [&_h2]:text-[12px] [&_h2]:font-medium [&_h2]:leading-[1.65] [&_h2]:tracking-wide [&_h2]:uppercase [&_li]:font-[ui-monospace,'Cascadia_Code',Consolas,monospace] [&_li]:text-[12px] [&_li]:font-medium [&_li]:leading-[1.65] [&_li]:tracking-wide [&_li]:uppercase [&_h2]:mb-8 [&_h2]:text-paper [&_.column-footer-name]:pl-3.5 [&_.column-footer-name]:[border-left:2px_solid_var(--color-brick)] [&_.column-footer-name]:[font:600_28px/1.05_var(--font-display)] [&_.column-footer-name]:tracking-[0.02em] [&_ul]:[list-style:none] [&_ul]:m-0 [&_ul]:p-0 [&_li]:text-[#b3b2b0] [&_a]:inline-flex [&_a]:items-center [&_a]:min-h-9 [&_a]:max-w-full [&_a]:wrap-anywhere [&_a]:[transition:color_160ms_ease] [&_a:hover]:text-[white] [&_a:hover]:[text-decoration:underline] [&_a:hover]:underline-offset-[5px] max-[1101px]:[&_h2]:mb-5 max-[600px]:pt-8 max-[600px]:[&_h2]:text-[11px] max-[600px]:[&_li]:text-[11px] max-[600px]:[&_a]:min-h-11 motion-reduce:[&_a]:[transition:none]" id="contact" aria-label="Pied de page">
  <div class="column-footer-inner max-w-400 mx-auto">
    <div class="column-footer-grid grid grid-cols-[1.45fr_repeat(4,minmax(0,1fr))] *:min-w-0 *:min-h-67.5 *:p-[20px_clamp(20px,2.3vw,44px)_28px] *:[border-left:1px_solid_#fafaf826] *:first:pl-0 *:first:[border-left:0] *:last:pr-0 max-[1101px]:grid-cols-2 max-[1101px]:*:min-h-0 max-[1101px]:*:p-[28px_24px] max-[1101px]:*:[border-top:1px_solid_#fafaf826] max-[1101px]:*:first:col-span-full max-[1101px]:*:first:p-[0_0_32px] max-[1101px]:*:first:[border-top:0] max-[1101px]:[&_>_:nth-child(even)]:[border-left:0] max-[1101px]:[&_>_:nth-child(even)]:pl-0 max-[1101px]:[&_>_:nth-child(odd):not(:first-child)]:pr-0 max-[600px]:*:p-[24px_16px]">
      <div class="column-footer-identity">
        <h2 class="column-footer-name [&_>_span]:block">
          <span>Melvyn</span>
          <span>Philippon</span>
        </h2>
        <a class="column-footer-email font-[ui-monospace,'Cascadia_Code',Consolas,monospace] text-[12px] font-medium leading-[1.65] tracking-wide uppercase text-[#b3b2b0] min-h-11 max-[600px]:text-[11px]" href={`mailto:${site.email}`}>
          {site.email}
        </a>
        {site.socials.length > 0 && (
          <ul class="column-footer-socials flex flex-wrap gap-[4px_18px] mt-7! [&_a]:text-[10px]">
            {site.socials.map((social) => (
              <li>
                <a href={social.url} target="_blank" rel="noopener noreferrer">
                  {social.name}
                  <span class="sr-only"> (nouvel onglet)</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      <nav aria-label="Pages du portfolio">
        <h2>À découvrir</h2>
        <ul>
          <li>
            <a href="/projets/">Mes projets</a>
          </li>
          <li>
            <a href="/a-propos/">À propos</a>
          </li>
        </ul>
      </nav>
      <div>
        <h2>Mes domaines</h2>
        <ul>
          <li>Identité visuelle</li>
          <li>Design d’interfaces</li>
          <li>Développement web</li>
        </ul>
      </div>
      <div>
        <h2>Mon parcours</h2>
        <ul>
          <li>BUT MMI</li>
          <li>Création numérique</li>
          <li>Montbéliard</li>
        </ul>
      </div>
      <div>
        <h2>Échangeons</h2>
        <ul>
          <li>
            <a href="/contact/">Me contacter</a>
          </li>
          <li>
            {site.phone}
          </li>
          <li>{site.location}</li>
        </ul>
      </div>
    </div>
    <div class="column-footer-bottom font-[ui-monospace,'Cascadia_Code',Consolas,monospace] font-medium leading-[1.65] tracking-wide uppercase flex items-center justify-between flex-wrap gap-[12px_24px] [border-top:1px_solid_#fafaf826] pt-6 text-[#a5a4a2] text-[10px] [&_>_div]:flex [&_>_div]:items-center [&_>_div]:gap-3 [&_a]:min-h-11 max-[600px]:flex-col max-[600px]:items-start max-[600px]:gap-1 max-[600px]:text-[9px] max-[600px]:[&_>_div]:gap-2 max-[600px]:[&_>_div]:flex-wrap">
      <p>
        © {new Date().getFullYear()} {site.name}
      </p>
      <div>
        <a href="/mentions-legales/">Mentions légales</a>
        <span aria-hidden="true"> / </span>
        <a href="/confidentialite/">Confidentialité</a>
      </div>
    </div>
  </div>
</footer>
