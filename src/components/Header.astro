---
const current = Astro.url.pathname;
const darkPage = current === "/projets/" || current === "/contact/";
const links = [
  { href: "/projets/", label: "Projets" },
  { href: "/a-propos/", label: "À propos" },
  { href: "/contact/", label: "Contact" },
];
---

<a href="#contenu" class="skip-link fixed z-100 top-2 left-2 p-[14px_20px] [background:var(--color-brick)] [color:white] [transform:translateY(-150%)] focus:[transform:translateY(0)]">Aller au contenu</a>
<header class="site-header static h-0 p-0 block [background:transparent] [border:0] [box-shadow:none] [color:white] pointer-events-none">
  <a class="brand inline-flex items-center justify-center min-w-11 min-h-11 fixed z-50 top-4 left-[clamp(24px,_4.03vw,_80px)] pointer-events-auto [color:#000] [transition:color_160ms_ease] motion-reduce:[transition:none] [&[data-header-ink='white']]:[color:#fff]" href="/" aria-label="Melvyn Philippon — Accueil" data-header-contrast data-header-ink={darkPage ? "white" : "black"}>
    <span class="brand-symbol block w-6.25 h-10.5 [background:currentColor] [-webkit-mask:url('/images/logo.svg')_center_/_contain_no-repeat] [mask:url('/images/logo.svg')_center_/_contain_no-repeat]" aria-hidden="true"></span>
  </a>
  <button class="hamburger-trigger fixed z-50 top-4 right-[clamp(24px,_4.03vw,_80px)] grid place-items-center w-11 h-11 [background:transparent] [color:#000] [border:0] pointer-events-auto [transition:color_160ms_ease] [&[aria-expanded='true']_.hamburger-icon_>_:first-child]:[transform:translateY(8px)_rotate(45deg)] [&[aria-expanded='true']_.hamburger-icon_>_:nth-child(2)]:opacity-0 [&[aria-expanded='true']_.hamburger-icon_>_:last-child]:[transform:translateY(-8px)_rotate(-45deg)] motion-reduce:[transition:none] [&[data-header-ink='white']]:[color:#fff]" type="button" data-open-menu aria-label="Ouvrir le menu" aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false" data-header-contrast data-header-ink={darkPage || current === "/" || current.startsWith("/projets/") ? "white" : "black"} hidden>
    <span class="hamburger-icon flex flex-col gap-1.5 w-6.5 [&_>_span]:block [&_>_span]:w-6.5 [&_>_span]:h-0.5 [&_>_span]:[background:currentColor] [&_>_span]:[transition:transform_220ms_ease,_opacity_160ms_ease] motion-reduce:[&_>_span]:[transition:none]" aria-hidden="true"><span></span><span></span><span></span></span>
  </button>

  <dialog id="site-menu" class="hamburger-panel fixed inset-0 w-full max-w-none h-[100svh] supports-[height:100dvh]:h-[100dvh] max-h-[none] m-0 p-0 [border:0] rounded-none [background:#101113] [color:#fafaf8] overflow-hidden [overscroll-behavior:contain] pointer-events-auto [&[open]]:grid [&[open]]:[grid-template-columns:1fr] backdrop:[background:#10111380]" aria-labelledby="menu-title" data-fullscreen-menu>
    <h2 id="menu-title" class="sr-only">Navigation principale</h2>
    <a class="menu-brand absolute z-3 top-4 left-[clamp(24px,_4.03vw,_80px)] [color:#fff]" href="/" aria-label="Melvyn Philippon — Accueil"><span class="brand-symbol block w-6.25 h-10.5 [background:currentColor] [-webkit-mask:url('/images/logo.svg')_center_/_contain_no-repeat] [mask:url('/images/logo.svg')_center_/_contain_no-repeat]" aria-hidden="true"></span></a>
    <button class="menu-close absolute z-3 top-4 right-[clamp(24px,_4.03vw,_80px)] grid place-items-center w-11 h-11 p-0 [background:transparent] [color:#fff] [border:0] [&_svg]:[transition:rotate_300ms_ease] [&:hover_svg]:[rotate:90deg] motion-reduce:[&_svg]:[transition:none]" type="button" data-close-menu aria-label="Fermer le menu" autofocus>
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true"><path d="m4 4 18 18M22 4 4 22" stroke="currentColor" stroke-width="1.5" /></svg>
    </button>
    <div class="menu-main flex flex-col min-w-0 min-h-0 p-[84px_0_20px] [@media((max-height:_650px))]:pt-19 [@media((max-height:_650px))]:pb-5 [@media((max-height:_480px))]:[&&]:pt-16 [@media((max-height:_480px))]:[&&]:pb-3">
      <nav class="menu-navigation flex items-stretch [flex:1] min-h-0 [&_ul]:grid [&_ul]:[grid-template-rows:repeat(4,_minmax(0,_1fr))] [&_ul]:w-full [&_li]:min-h-0" aria-label="Navigation principale">
        <ul>
          {links.map((link, index) => (
            <li style={`--menu-step: ${index}`}>
              <a class="menu-link relative isolate flex items-center h-full gap-6.5 p-[clamp(10px,_1.8dvh,_22px)_clamp(24px,_4.03vw,_80px)] [&:hover_.menu-label-mask]:[translate:22px_0] [&:focus-visible_.menu-label-mask]:[translate:22px_0] [&:hover_.menu-link-line]:opacity-100 [&:hover_.menu-link-line]:[transform:scaleX(1)] [&:focus-visible_.menu-link-line]:opacity-100 [&:focus-visible_.menu-link-line]:[transform:scaleX(1)] max-[900px]:pl-6 max-[900px]:pr-4 max-[900px]:gap-2.5 max-[900px]:[&:hover_.menu-label-mask]:[translate:12px_0] max-[900px]:[&:focus-visible_.menu-label-mask]:[translate:12px_0] [@media((max-height:_650px))]:py-2.5 [@media((max-height:_480px))]:[&&]:py-1.5" href={link.href} aria-current={current.startsWith(link.href) ? "page" : undefined}>
                <span class="menu-link-line menu-link-line-before min-w-0 h-0.75 [background:var(--color-brick,_#a33333)] opacity-0 [transform:scaleX(0)] [transition:opacity_200ms,_transform_550ms_cubic-bezier(.16,1,.3,1)] [flex:0_0_calc(24px_+_var(--menu-step)_*_8vw)] ml-0 [transform-origin:right] max-[900px]:[flex:0_0_clamp(28px,_8vw,_70px)] max-[900px]:h-0.5 max-[900px]:ml-0 motion-reduce:[transition:none] min-[900px]:max-[1101px]:basis-[calc(24px_+_var(--menu-step)_*_4vw)] max-[900px]:basis-[calc(12px_+_var(--menu-step)_*_2.5vw)]" aria-hidden="true"></span>
                <span class="menu-label-mask block overflow-clip p-[.06em_18px_.12em_0] [margin-block:-.06em_-.12em] [transition:translate_500ms_cubic-bezier(.16,1,.3,1)] motion-reduce:[transition:none]"><span class="menu-label relative block whitespace-nowrap [font:500_clamp(48px,_min(11vw,_16dvh),_180px)/1.05_var(--font-sans)] uppercase tracking-[-.065em] [color:#fafaf8] [transition:color_250ms] max-[900px]:text-[clamp(36px,_min(12vw,_16dvh),_108px)] [@media((max-height:_650px))]:text-[clamp(36px,_min(11vw,_15.5dvh),_100px)] [@media((max-height:_480px))]:[&&]:text-[clamp(30px,_min(10vw,_14.5dvh),_66px)] motion-reduce:[transition:none]" data-menu-reveal>{link.label}</span></span>
                <span class="menu-link-line [flex:1_1_0] min-w-0 h-0.75 ml-2 [background:var(--color-brick,_#a33333)] opacity-0 [transform:scaleX(0)] [transform-origin:left] [transition:opacity_200ms,_transform_550ms_cubic-bezier(.16,1,.3,1)] max-[900px]:[flex:0_0_clamp(28px,_8vw,_70px)] max-[900px]:h-0.5 max-[900px]:ml-0 motion-reduce:[transition:none]" aria-hidden="true"></span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </dialog>
</header>
<noscript>
  <nav class="fixed right-6 bottom-6 z-100 flex flex-wrap gap-4 bg-ink px-4 py-3 text-sm text-paper" aria-label="Navigation principale sans JavaScript">
    {links.map((link) => <a href={link.href} aria-current={current.startsWith(link.href) ? "page" : undefined}>{link.label}</a>)}
  </nav>
</noscript>
<script>
  import "../scripts/header-contrast.js";
  import "../scripts/fullscreen-menu.js";
</script>
