---
const {
  href,
  label,
  filled = false,
  external = false,
} = Astro.props;
---

<a
  href={href}
  class:list={[
    "button-link inline-flex items-center justify-between gap-4.5 min-h-13.75 w-fit max-w-full p-[16px_22px] [border:2px_solid_currentColor] text-[13px] uppercase leading-[1.3] [transition:color_0.15s,_background-color_0.15s] [&_svg]:shrink-0 hover:[background:var(--color-ink)] hover:[color:white] [&:hover_img]:[filter:brightness(0)_invert(1)]",
    { "button-filled [background:var(--color-brick)] [color:white] [border-color:var(--color-brick)]": filled },
  ]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <span>{label}</span>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
    <path d="M12.2929 7.29289C12.6834 6.90237 13.3166 6.90237 13.7071 7.29289L17.7071 11.2929C18.0976 11.6834 18.0976 12.3166 17.7071 12.7071L13.7071 16.7071C13.3166 17.0976 12.6834 17.0976 12.2929 16.7071C11.9024 16.3166 11.9024 15.6834 12.2929 15.2929L14.5858 13H7C6.44772 13 6 12.5523 6 12C6 11.4477 6.44772 11 7 11H14.5858L12.2929 8.70711C11.9024 8.31658 11.9024 7.68342 12.2929 7.29289Z" fill-rule="evenodd" clip-rule="evenodd" fill={filled ? "#fff" : "#14161d"} />
  </svg>
  {external && <span class="sr-only"> (nouvel onglet)</span>}
</a>
