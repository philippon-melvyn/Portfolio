---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MenuTransition from "../components/MenuTransition.astro";
import { site } from "../data/site.js";
const {
  title,
  description = site.description,
  image,
  noindex = false,
  footer = true,
  header = true,
  bodyClass,
} = Astro.props;
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — Création numérique & design graphique`;
const domain = import.meta.env.SITE_URL;
const canonical = domain ? new URL(Astro.url.pathname, domain).href : null;
const shareImage =
  image || (domain ? new URL("/images/portrait.webp", domain).href : null);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <MenuTransition />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link
      rel="preload"
      href="/fonts/barlow-condensed-600.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta
      name="twitter:card"
      content={shareImage ? "summary_large_image" : "summary"}
    />
  </head>
  <body class={bodyClass}>
    {header && <Header />}
    <main id="contenu" tabindex="-1" class:list={{ "without-header": !header }}>
      <slot />
    </main>
    {footer && <Footer />}
  </body>
</html>
