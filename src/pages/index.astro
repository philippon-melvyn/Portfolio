---
import '../styles/global.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Page temporaire de vérification de l’installation Astro et Tailwind CSS." />
    <title>Installation — Portfolio de Melvyn Philippon</title>
  </head>
  <body class="min-h-screen bg-slate-950 px-6 py-16 font-sans text-slate-100 sm:py-24">
    <main class="mx-auto max-w-2xl rounded-2xl border border-slate-700 bg-slate-900 p-8 sm:p-12">
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-emerald-300">Portfolio de Melvyn Philippon</p>
      <h1 class="text-3xl font-bold sm:text-5xl">Astro et Tailwind sont installés.</h1>
      <p class="mt-6 leading-relaxed text-slate-300">Cette page temporaire permet de vérifier l’installation. Le développement du portfolio commencera après validation de la phase 1.</p>
      <p class="mt-8 inline-block rounded-full bg-emerald-300 px-4 py-2 font-semibold text-slate-950">Phase 1 · Installation</p>
    </main>
  </body>
</html>
