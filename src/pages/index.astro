---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeIntroduction from "../components/HomeIntroduction.astro";
import ProjectCarousel from "../components/ProjectCarousel.astro";
import SkillsOverview from "../components/SkillsOverview.astro";
import { getProjects, getKnowledge, getSkills } from "../lib/pocketbase.js";
const [projects, knowledge, skills] = await Promise.all([
  getProjects(),
  getKnowledge(),
  getSkills(),
]);
---

<BaseLayout>
  <HomeIntroduction />
  <section class="home-statement block relative [background:#fafaf8] text-ink p-[clamp(100px,10vw,180px)_6.5%] [&_h2]:max-w-310 [&_h2]:m-0 [&_h2]:[font:500_clamp(46px,6vw,110px)/1.05_var(--font-sans)] [&_h2]:tracking-[-.055em] [&_h2]:text-pretty [&_h2]:text-ink [&_p]:w-[43%] [&_p]:m-[clamp(70px,8vw,150px)_7%_0_auto] [&_p]:text-[#555550] [&_p]:text-[clamp(16px,1.3vw,24px)] [&_p]:leading-[1.55] [&_p]:tracking-[-.035em] max-[700px]:p-[90px_24px] max-[700px]:[&_p]:w-full max-[700px]:[&_p]:max-w-110 max-[700px]:[&_p]:m-[60px_0_0_auto] print:p-[40px_24px] print:[&_p]:w-full print:[&_p]:mt-10" aria-labelledby="home-statement-title">
      <h2 id="home-statement-title" data-home-reveal class="[&[data-home-reveal][data-reveal-ready]]:opacity-0 [&[data-home-reveal][data-reveal-ready]]:transform-[translateY(36px)] [&[data-home-reveal][data-reveal-ready]]:[transition:opacity_900ms_ease,transform_1100ms_cubic-bezier(.16,1,.3,1)] [&[data-home-reveal][data-reveal-ready][data-reveal-ready='visible']]:opacity-100 [&[data-home-reveal][data-reveal-ready][data-reveal-ready='visible']]:transform-none motion-reduce:[&[data-home-reveal][data-reveal-ready]]:opacity-100 motion-reduce:[&[data-home-reveal][data-reveal-ready]]:transform-none motion-reduce:[&[data-home-reveal][data-reveal-ready]]:[transition:none] print:[&[data-home-reveal][data-reveal-ready]]:opacity-100 print:[&[data-home-reveal][data-reveal-ready]]:transform-none">Donner forme aux idées.</h2>
      <p data-home-reveal class="[&[data-home-reveal][data-reveal-ready]]:opacity-0 [&[data-home-reveal][data-reveal-ready]]:transform-[translateY(36px)] [&[data-home-reveal][data-reveal-ready]]:[transition:opacity_900ms_ease,transform_1100ms_cubic-bezier(.16,1,.3,1)] [&[data-home-reveal][data-reveal-ready][data-reveal-ready='visible']]:opacity-100 [&[data-home-reveal][data-reveal-ready][data-reveal-ready='visible']]:transform-none motion-reduce:[&[data-home-reveal][data-reveal-ready]]:opacity-100 motion-reduce:[&[data-home-reveal][data-reveal-ready]]:transform-none motion-reduce:[&[data-home-reveal][data-reveal-ready]]:[transition:none] print:[&[data-home-reveal][data-reveal-ready]]:opacity-100 print:[&[data-home-reveal][data-reveal-ready]]:transform-none">
        De l’identité visuelle à la maquette web, j’imagine et conçois des
        créations adaptées à votre projet. Mon objectif : traduire vos idées en
        visuels cohérents, expressifs et pensés pour votre public.
      </p>
  </section>
  <ProjectCarousel projects={projects.slice(0, 3)} />
  <section class="home-project-summary flex items-center min-h-[75svh] p-[clamp(88px,12vw,180px)_8vw] [background:var(--color-brick,#a33333)] text-paper [&_p:first-child]:m-0 [&_p:first-child]:[font:500_clamp(19px,1.55vw,28px)/1.6_var(--font-sans)] [&_p:first-child]:tracking-tight [&_p+p]:m-[32px_0_0] [&_p+p]:[font:500_clamp(15px,1.05vw,18px)/1.75_var(--font-sans)] [&_p+p]:text-[#fafaf8cc] max-[900px]:min-h-0 max-[900px]:p-[88px_24px] print:h-auto" aria-label="Au fil des projets">
    <div class="home-project-summary-copy w-[50%] max-w-160 max-[900px]:w-[72%] max-[600px]:w-full">
      <p>Ces projets ont enrichi mes compétences en création, en développement et en communication. Des savoir-faire complémentaires sur lesquels je m’appuie pour concevoir des réalisations cohérentes et adaptées à leurs objectifs.</p>
      <p>Au fil des expériences, ma pratique s’est affinée : défendre mes choix, m’adapter aux contraintes et collaborer avec des profils différents. Cette diversité nourrit mon approche et renforce mon autonomie.</p>
    </div>
  </section>
  <SkillsOverview skills={skills} knowledge={knowledge} />
</BaseLayout>
<script>
import { htmlElement } from "../scripts/dom.js";
  // home-introduction
function introState(progress) {
  const p = Math.max(0, Math.min(1, progress));
  function phase(start, end) {
    const t = Math.max(0, Math.min(1, (p - start) / (end - start)));
    return t * t * (3 - 2 * t);
  }
  return {
    slide: phase(.08, 1),
    nameOpacity: 1 - phase(.02, .38),
    nameX: -48 * phase(0, .4),
    shade: phase(.16, .8),
  };
}

// Interactions
const root = htmlElement(document, "[data-home-introduction]");
if (root) {
  const preference = window.matchMedia("(prefers-reduced-motion: reduce)");
  const space = htmlElement(root, "[data-intro-zoom-space]");
  const texts = [...(document.querySelectorAll?.("[data-home-reveal]") || [])];
  const properties = ["slide", "name-opacity", "name-x", "shade"];
  let frame = undefined;
  let lastProgress = undefined;
  let observer = undefined;

  function update(force = false) {
    frame = undefined;
    if (preference.matches) return;
    const progress = Math.max(0, Math.min(1, -root.getBoundingClientRect().top / Math.max(1, space.offsetHeight)));
    if (!force && progress === lastProgress) return;
    lastProgress = progress;
    const state = introState(progress);
    const values = { slide: state.slide, "name-opacity": state.nameOpacity, "name-x": `${state.nameX}px`, shade: state.shade };
    for (const [name, value] of Object.entries(values)) root.style.setProperty(`--intro-${name}`, String(value));
  }
  function requestUpdate() {
    if (frame === undefined && !preference.matches) frame = window.requestAnimationFrame(() => update());
  }
  function configure() {
    if (frame !== undefined) window.cancelAnimationFrame(frame);
    frame = undefined;
    observer?.disconnect();
    if (preference.matches) {
      root.removeAttribute("data-intro-ready");
      properties.forEach((name) => root.style.removeProperty(`--intro-${name}`));
      texts.forEach((text) => text.removeAttribute("data-reveal-ready"));
      lastProgress = undefined;
      return;
    }
    root.setAttribute("data-intro-ready", "");
    update(true);
    if (typeof IntersectionObserver !== "undefined") {
      observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.setAttribute("data-reveal-ready", "visible");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0, rootMargin: "0px 0px -6% 0px" });
      texts.forEach((text) => {
        if (text.getAttribute("data-reveal-ready") === "visible") return;
        // Text already above the viewport must remain readable after restoration.
        if (text.getBoundingClientRect().top < window.innerHeight * .94) {
          text.setAttribute("data-reveal-ready", "visible");
        } else {
          text.setAttribute("data-reveal-ready", "");
          observer.observe(text);
        }
      });
    }
  }
  window.addEventListener("scroll", requestUpdate, { passive: true });
  window.addEventListener("resize", configure, { passive: true });
  window.addEventListener("pageshow", configure);
  window.addEventListener("pagehide", () => {
    if (frame !== undefined) window.cancelAnimationFrame(frame);
    frame = undefined;
    observer?.disconnect();
  });
  preference.addEventListener("change", configure);
  configure();
}
</script>

<script>
import { htmlElement, htmlElements, containsTarget } from "../scripts/dom.js";
  // home-projects
const root = htmlElement(document, "[data-home-projects]");
if (root) {
  const stage = htmlElement(root, "[data-home-project-stage]");
  const track = htmlElement(root, "[data-home-project-track]");
  const panels = [...htmlElements(root, "[data-home-project-panel]")];
  const desktop = window.matchMedia("(min-width: 900px)");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  let enabled = false;
  let distance = 0;
  let position = 0;
  let frame = undefined;

  function update() {
    frame = undefined;
    if (!enabled) return;
    position = Math.max(0, Math.min(distance, -root.getBoundingClientRect().top));
    track.style.setProperty("transform", `translate3d(${-position}px, 0, 0)`);
  }
  function requestUpdate() {
    if (enabled && frame === undefined) frame = window.requestAnimationFrame(update);
  }
  function configure() {
    if (frame !== undefined) window.cancelAnimationFrame(frame);
    frame = undefined;
    enabled = desktop.matches && !reduced.matches;
    track.style.removeProperty("transform");
    if (!enabled) {
      root.removeAttribute("data-horizontal-ready");
      root.style.removeProperty("height");
      return;
    }
    root.setAttribute("data-horizontal-ready", "");
    stage.scrollLeft = 0;
    distance = Math.max(0, (panels.length - 1) * stage.clientWidth);
    root.style.setProperty("height", `${stage.offsetHeight + distance}px`);
    update();
  }
  function goTo(index) {
    const target = Math.max(0, Math.min(panels.length - 1, index));
    if (!panels[target]) return;
    if (enabled) {
      window.scrollTo({
        top: window.scrollY + root.getBoundingClientRect().top + target * stage.clientWidth,
        behavior: "instant",
      });
      update();
    } else {
      stage.scrollTo({ left: panels[target].offsetLeft, behavior: "instant" });
    }
  }
  stage.addEventListener("keydown", (event) => {
    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    const current = Math.round((enabled ? position : stage.scrollLeft) / Math.max(1, stage.clientWidth));
    const target = { ArrowLeft: current - 1, ArrowRight: current + 1, Home: 0, End: panels.length - 1 }[event.key];
    if (target === undefined) return;
    event.preventDefault();
    goTo(target);
  });
  stage.addEventListener("focusin", (event) => {
    const index = panels.findIndex((panel) => containsTarget(panel, event.target));
    if (index >= 0 && enabled) goTo(index);
  });
  // The browser owns the wheel: no forced destination, timer or gesture lock.
  window.addEventListener("scroll", requestUpdate, { passive: true });
  window.addEventListener("resize", configure, { passive: true });
  window.addEventListener("pageshow", configure);
  window.addEventListener("pagehide", () => {
    if (frame !== undefined) window.cancelAnimationFrame(frame);
    frame = undefined;
  });
  desktop.addEventListener("change", configure);
  reduced.addEventListener("change", configure);
  configure();
}
</script>

<script>
import { htmlElement, htmlElements } from "../scripts/dom.js";
  // tool-directory
const root = htmlElement(document, "[data-tool-carousel]");
if (root) {
  const rows = [...htmlElements(root, "[data-tool-row]")];
  const preference = window.matchMedia("(prefers-reduced-motion: reduce)");
  let enabled = false;
  let step = 1;
  let distance = 0;
  let frame = undefined;
  const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

  function update() {
    frame = undefined;
    if (!enabled) return;
    const position = clamp(-root.getBoundingClientRect().top, 0, distance) / step;
    const current = Math.floor(position);
    const phase = clamp((position - current - .25) / .6, 0, 1);
    const mix = phase * phase * (3 - 2 * phase);
    rows.forEach((row, index) => {
      let opacity = 0;
      let offset = 48;
      if (index === current) { opacity = 1 - mix; offset = -mix * 48; }
      else if (index === current + 1) { opacity = mix; offset = (1 - mix) * 48; }
      row.style.setProperty("opacity", String(opacity));
      row.style.setProperty("transform", `translate3d(0, ${offset}px, 0)`);
    });
  }
  function requestUpdate() {
    if (enabled && frame === undefined) frame = window.requestAnimationFrame(update);
  }
  function configure() {
    if (frame !== undefined) window.cancelAnimationFrame(frame);
    frame = undefined;
    enabled = rows.length > 1 && !preference.matches;
    if (!enabled) {
      root.removeAttribute("data-tool-ready");
      root.style.removeProperty("height");
      rows.forEach((row) => {
        row.style.removeProperty("opacity");
        row.style.removeProperty("transform");
      });
      return;
    }
    step = clamp(window.innerHeight * .32, 180, 320);
    distance = (rows.length - 1) * step;
    root.setAttribute("data-tool-ready", "");
    root.style.setProperty("height", `${window.innerHeight + distance}px`);
    update();
  }
  // Scrolling controls the words inside the sticky stage; no autoplay or wheel lock.
  window.addEventListener("scroll", requestUpdate, { passive: true });
  window.addEventListener("resize", configure, { passive: true });
  window.addEventListener("pageshow", configure);
  window.addEventListener("pagehide", () => {
    if (frame !== undefined) window.cancelAnimationFrame(frame);
    frame = undefined;
  });
  preference.addEventListener("change", configure);
  configure();
}
</script>
