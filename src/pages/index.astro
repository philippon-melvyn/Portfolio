---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeIntroduction from "../components/HomeIntroduction.astro";
import ProjectCarousel from "../components/ProjectCarousel.astro";
import KnowledgeCarousel from "../components/KnowledgeCarousel.astro";
import { getProjects, getKnowledge } from "../lib/pocketbase.js";
const [projects, knowledge] = await Promise.all([
  getProjects(),
  getKnowledge(),
]);
---

<BaseLayout>
  <HomeIntroduction />
  <section class="home-statement" aria-labelledby="home-statement-title">
      <h2 id="home-statement-title" data-home-reveal>Donner forme aux idées.</h2>
      <p data-home-reveal>
        De l’identité visuelle à la maquette web, j’imagine et conçois des
        créations adaptées à votre projet. Mon objectif : traduire vos idées en
        visuels cohérents, expressifs et pensés pour votre public.
      </p>
  </section>
  <ProjectCarousel projects={projects.slice(0, 3)} />
  <section
    class="panel home-skills bg-brick text-white"
    aria-labelledby="skills-title"
  >
    <h2 id="skills-title" class="heading-large max-w-4xl">
      Mes compétences
    </h2>
    <p class="mt-14 max-w-xl">
      De la conception visuelle à la réalisation web, mes compétences se
      complètent pour répondre aux besoins de chaque projet.
    </p>
  </section>
  <KnowledgeCarousel knowledge={knowledge} />
</BaseLayout>
<script>
  import "../scripts/carousel.js";
</script>
