---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectSections from "../../components/project/ProjectSections.astro";
import ArrowLink from "../../components/ArrowLink.astro";
import ProjectImage from "../../components/ProjectImage.astro";
import {
  getProjects,
  getSections,
  imagesFor,
  relatedRecords,
} from "../../lib/pocketbase.js";
import { asArray, editorHtml, plainText, safeLink } from "../../lib/content.js";
import "../../styles/project-navigation.css";
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
const sections = await getSections(project.id);
const cover = imagesFor(project, "couverture")[0];
const knowledge = relatedRecords(project, "savoirs");
const skills = relatedRecords(project, "competences");
const links = [1, 2]
  .map((number) => ({
    label: project[`liens_libelle_${number}`]?.trim(),
    url: safeLink(project[`liens_url_${number}`]),
    image: imagesFor(project, `liens_img_${number}`)[0],
  }))
  .filter((link) => link.label && link.url);
---

<BaseLayout
  title={project.titre}
  description={plainText(project.introduction).slice(0, 180)}
  image={cover}
>
  <article>
    <header class="project-hero split-reverse">
      <div class="panel project-intro">
        <h1 class="heading-large">{project.titre}</h1>
        <dl class="project-meta">
          <div>
            <dt>Domaines</dt>
            <dd>
              {asArray(project.domaines).map((domain) => (
                <span class="block">{domain.trim()}</span>
              ))}
            </dd>
          </div>
          {project.annee && (
            <div>
              <dt>Année</dt>
              <dd>{project.annee}</dd>
            </div>
          )}
        </dl>
        {project.introduction && (
          <div class="rich-text" set:html={editorHtml(project.introduction)} />
        )}
      </div>
      {cover ? (
        <ProjectImage
          class="project-hero-image"
          src={cover}
          alt={project.couverture_alt || project.titre}
          priority
          transitionName={`project-cover-${project.slug}`}
        />
      ) : (
        <div class="project-hero-placeholder" aria-hidden="true"></div>
      )}
    </header>
    <ProjectSections sections={sections} />
    {(knowledge.length > 0 || skills.length > 0) && (
      <section class="project-related panel">
        {skills.length > 0 && (
          <div>
            <h2 class="heading-medium">Compétences mobilisées</h2>
            <ul class="skill-tags">
              {skills.map((skill) => (
                <li>{skill.titre}</li>
              ))}
            </ul>
          </div>
        )}
        {knowledge.length > 0 && (
          <div>
            <h2 class="heading-medium">Savoirs utilisés</h2>
            <ul class="knowledge-list">
              {knowledge.map((item) => {
                const logo = imagesFor(item, "logo")[0];
                return (
                  <li>
                    {logo && (
                      <img
                        src={logo}
                        width="64"
                        height="64"
                        alt=""
                        loading="lazy"
                      />
                    )}
                    <span>{item.nom}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </section>
    )}
    {links.length > 0 && (
      <section
        aria-label="Découvrir les réalisations finales"
        class="project-final-links"
      >
        {links.map((link) => (
          <div>
            {link.image && (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                tabindex="-1"
                aria-hidden="true"
              >
                <ProjectImage
                  src={link.image}
                  alt=""
                  sizes="(max-width: 899px) 100vw, 50vw"
                />
              </a>
            )}
            <div class="panel">
              <ArrowLink href={link.url} label={link.label} external />
            </div>
          </div>
        ))}
      </section>
    )}
  </article>
</BaseLayout>
