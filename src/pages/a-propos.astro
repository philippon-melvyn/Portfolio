---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import portrait from "../../public/images/portrait.webp";
import "../styles/about-studio.css";
const method = [
  { title: "Comprendre", text: "Cerner les objectifs, le public et les contraintes." },
  { title: "Explorer", text: "Rassembler des références et esquisser plusieurs pistes." },
  { title: "Concevoir", text: "Développer une direction et garder une cohérence d’ensemble." },
  { title: "Ajuster", text: "Confronter mes choix aux retours et aux tests." },
  { title: "Livrer", text: "Vérifier les détails et préparer les supports adaptés." },
];
---

<BaseLayout title="À propos" description="Mon parcours en BUT MMI, mes inspirations et ma façon de travailler en création numérique.">
  <div class="about-story" data-about-story>
    <section class="about-introduction" id="about-profil" aria-labelledby="profil-title" data-about-section>
      <div class="about-wrap">
        <p class="about-label about-introduction-label" data-about-reveal><span>01 /</span> Présentation</p>
        <div class="about-introduction-grid">
          <figure class="about-portrait" data-about-reveal data-about-effect="portrait">
            <Image src={portrait} widths={[320, 520, 720]} width={520} sizes="(min-width: 900px) 260px, (min-width: 600px) 220px, 180px" format="webp" alt="Portrait de Melvyn Philippon" loading="eager" fetchpriority="high" />
            <figcaption>20 ans · Chenebier, France</figcaption>
          </figure>
          <div class="about-introduction-main">
            <h1 id="profil-title" class="about-editorial-title" data-about-reveal data-about-effect="lines"><span class="about-motion-line"><span class="about-line-content">Melvyn Philippon.</span></span></h1>
            <p class="about-introduction-role" data-about-reveal>Étudiant en création numérique.</p>
            <div class="about-introduction-copy" data-about-reveal>
              <p>Curieux et créatif, j’aime dessiner, explorer de nouveaux univers et imaginer ce que je pourrais en faire à ma manière.</p>
              <p>Persévérant, je prends le temps d’essayer, d’ajuster et d’apprendre, en restant ouvert aux regards des autres.</p>
            </div>
          </div>
        </div>
        <div id="about-parcours" class="about-education" data-about-reveal>
          <h2 class="about-label">Mon parcours</h2>
          <ol>
            <li><span class="about-date">2024 — 2028</span><div><h3>BUT MMI · Montbéliard</h3><p>Deuxième année, parcours Création numérique.</p></div></li>
            <li><span class="about-date">2022 — 2024</span><div><h3>Bac STI2D</h3><p>Innovation technologique et éco-conception.</p></div></li>
          </ol>
        </div>
      </div>
    </section>

    <section id="about-inspirations" class="about-inspirations" aria-labelledby="inspirations-title" data-about-section>
      <div class="about-wrap">
        <p class="about-label" data-about-reveal><span>02 /</span> Inspirations</p>
        <h2 id="inspirations-title" class="about-statement" data-about-reveal data-about-effect="lines"><span class="about-motion-line"><span class="about-line-content about-muted">Des univers à explorer.</span></span> <span class="about-motion-line"><span class="about-line-content">Des histoires qui donnent</span></span> <span class="about-motion-line"><span class="about-line-content">envie de <em>créer.</em></span></span></h2>
        <div class="about-inspirations-copy">
          <p data-about-reveal>Le manga, l’animation et les jeux vidéo nourrissent mon imagination par leurs ambiances, leurs personnages et leur manière de raconter des histoires. La mythologie et le folklore fantastique m’attirent pour la richesse de leurs univers.</p>
          <p data-about-reveal>À travers le dessin, je prolonge ces découvertes et explore mes propres idées, avec l’envie de créer des visuels qui racontent quelque chose.</p>
        </div>
      </div>
    </section>

    <section id="about-methode" class="about-method" aria-labelledby="methode-title" data-about-section>
      <div class="about-wrap about-method-layout">
        <div class="about-method-heading">
          <p class="about-label" data-about-reveal><span>03 /</span> Méthode</p>
          <h2 id="methode-title" class="about-editorial-title" data-about-reveal data-about-effect="lines"><span class="about-motion-line"><span class="about-line-content">Essayer.</span></span> <span class="about-motion-line"><span class="about-line-content">Ajuster.</span></span> <span class="about-motion-line"><span class="about-line-content about-red">Apprendre.</span></span></h2>
          <p class="about-method-note" data-about-reveal>En équipe, je privilégie l’écoute, les échanges et les retours pour faire avancer le projet.</p>
        </div>
        <ol class="about-method-list">
          {method.map((step, index) => <li data-about-reveal data-about-effect="step"><span class="about-step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
        </ol>
        <div class="about-actions" data-about-reveal>
          <a class="about-button" href="/projets/">Voir mes projets <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" /></svg></a>
          <a class="about-contact-link" href="/contact/">Me contacter</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
<script>
  import "../scripts/about-scroll.js";
</script>
