---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import portrait from "../../public/images/portrait.webp";
import "../styles/about-studio.css";
const method = [
  { title: "Comprendre", text: "Cerner les objectifs, le public et les contraintes." },
  { title: "Explorer", text: "Rassembler des références et esquisser plusieurs pistes." },
  { title: "Concevoir", text: "Développer une direction et garder une cohérence d’ensemble." },
  { title: "Ajuster", text: "Confronter mes choix aux retours et aux tests." },
  { title: "Livrer", text: "Vérifier les détails et préparer les supports adaptés." },
];
---

<BaseLayout title="À propos" description="Mon parcours en BUT MMI, mes inspirations et ma façon de travailler en création numérique.">
  <div class="about-story" data-about-story>
    <section class="about-introduction" id="about-profil" aria-labelledby="profil-title" data-about-section>
      <div class="about-wrap">
        <div class="about-hero-top" data-about-reveal>
          <p class="about-label">À propos</p>
        </div>
        <div class="about-hero-grid">
          <div class="about-hero-copy">
            <h1 id="profil-title" class="about-hero-title" data-about-reveal data-about-effect="lines">
              <span class="about-motion-line"><span class="about-line-content">Melvyn</span></span>
              <span class="about-motion-line"><span class="about-line-content">Philippon.</span></span>
            </h1>
            <div class="about-biography" data-about-reveal>
              <p class="about-bio-lead">Étudiant en création numérique.</p>
              <p>Curieux et créatif, j’aime dessiner, explorer de nouveaux univers et imaginer ce que je pourrais en faire à ma manière.</p>
              <p>Persévérant, je prends le temps d’essayer, d’ajuster et d’apprendre, en restant ouvert aux regards des autres.</p>
            </div>
          </div>
          <figure class="about-portrait" data-about-reveal data-about-effect="portrait">
            <div class="about-portrait-frame">
              <Image src={portrait} widths={[400, 640, 960, 1124]} width={960} sizes="(min-width: 900px) 38vw, (min-width: 600px) 62vw, 85vw" format="webp" alt="Portrait de Melvyn Philippon" loading="eager" fetchpriority="high" />
            </div>
            <figcaption>20 ans · Chenebier, France</figcaption>
          </figure>
        </div>
        <nav class="about-chapters" aria-label="Dans cette page" data-about-reveal>
          <a href="#about-parcours">Le parcours</a><a href="#about-inspirations">Les inspirations</a><a href="#about-methode">La méthode</a>
        </nav>
      </div>
    </section>

    <section id="about-parcours" class="about-journey" aria-labelledby="parcours-title" data-about-section>
      <div class="about-wrap about-journey-layout">
        <div class="about-journey-heading" data-about-reveal>
          <h2 id="parcours-title">Mon parcours.</h2>
        </div>
        <ol class="about-timeline">
          <li data-about-reveal>
            <span class="about-date">2022 — 2024</span>
            <div><h3>Bac STI2D</h3><p>Innovation technologique et éco-conception.</p></div>
          </li>
          <li data-about-reveal>
            <span class="about-date">2024 — 2028</span>
            <div><h3>BUT MMI · Montbéliard</h3><p>Deuxième année, parcours Création numérique.</p></div>
          </li>
        </ol>
      </div>
    </section>

    <section id="about-inspirations" class="about-inspirations" aria-labelledby="inspirations-title" data-about-section>
      <div class="about-wrap">
        <h2 id="inspirations-title" class="about-statement" data-about-reveal data-about-effect="lines">
          <span class="about-motion-line"><span class="about-line-content">Mes inspirations.</span></span>
        </h2>
        <div class="about-inspirations-copy">
          <p data-about-reveal>Le manga, l’animation et les jeux vidéo nourrissent mon imagination par leurs ambiances, leurs personnages et leur manière de raconter des histoires. La mythologie et le folklore fantastique m’attirent pour la richesse de leurs univers.</p>
          <p data-about-reveal>À travers le dessin, je prolonge ces découvertes et explore mes propres idées, avec l’envie de créer des visuels qui racontent quelque chose.</p>
        </div>
      </div>
    </section>

    <section id="about-methode" class="about-method" aria-labelledby="methode-title" data-about-section>
      <div class="about-wrap about-method-layout">
        <div class="about-method-heading">
          <p class="about-label" data-about-reveal>La méthode</p>
          <h2 id="methode-title" class="about-method-title" data-about-reveal data-about-effect="lines">
            <span class="about-motion-line"><span class="about-line-content">Essayer.</span></span>
            <span class="about-motion-line"><span class="about-line-content">Ajuster.</span></span>
            <span class="about-motion-line"><span class="about-line-content about-red">Apprendre.</span></span>
          </h2>
          <p class="about-method-note" data-about-reveal>En équipe, je privilégie l’écoute, les échanges et les retours pour faire avancer le projet.</p>
        </div>
        <ol class="about-method-list">
          {method.map((step, index) => <li data-about-reveal>
            <details class="about-method-step" open={index === 0}>
              <summary><span class="about-step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><h3>{step.title}</h3><span class="about-step-toggle" aria-hidden="true">+</span></summary>
              <p>{step.text}</p>
            </details>
          </li>)}
        </ol>
      </div>
    </section>

  </div>
</BaseLayout>
<script>
  import "../scripts/about-scroll.js";
</script>
