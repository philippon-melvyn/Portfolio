  import { formElement } from "../scripts/dom.js";
  import { setupContactForm } from "../scripts/contact-form.js";
  setupContactForm(formElement(document, "[data-contact-form]"));
</script>

<script>
import { htmlElement } from "../scripts/dom.js";
  // contact-switch
const root = htmlElement(document, "#contact-page");
const info = root ? htmlElement(root, "[data-contact-info]") : null;
const editor = root ? htmlElement(root, "[data-contact-editor]") : null;
const openButton = root ? htmlElement(root, "[data-open-contact]") : null;
const returnButton = root ? htmlElement(root, "[data-close-contact]") : null;

if (root && info && editor && openButton && returnButton) {
  function setView(message) {
    // Le panneau sortant quitte immédiatement la navigation clavier.
    // Les champs sont conservés lors des allers-retours.
    info.inert = message;
    editor.inert = !message;
    info.setAttribute("aria-hidden", String(message));
    editor.setAttribute("aria-hidden", String(!message));
    openButton.setAttribute("aria-expanded", String(message));
    root.dataset.contactView = message ? "message" : "details";
    (message ? editor : openButton).focus({ preventScroll: true });
  }

  openButton.addEventListener("click", () => setView(true));
  returnButton.addEventListener("click", () => setView(false));
  editor.addEventListener("keydown", (event) => {
    // Let the native subject picker handle Escape without closing the form.
    const inSelect = event.target instanceof Element && event.target.closest("select");
    if (event.key === "Escape" && !inSelect) {
      event.preventDefault();
      setView(false);
    }
  });
}
</script>
