---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import contactPattern from "../assets/engin-akyurt-pxA3AcRb0UE-unsplash.jpg";
import { safeLink } from "../lib/content.js";
import { site } from "../data/site.js";
const cvUrl = safeLink(import.meta.env.CV_URL);
---

<BaseLayout title="Contact" description="Une proposition de stage, un projet ou une question ? Contactez Melvyn Philippon." footer={false} bodyClass="contact-screen [body&]:h-full [body&]:overflow-hidden [body&_main]:h-full">
  <div id="contact-page" class="contact-studio relative isolate h-svh supports-[height:100dvh]:h-dvh overflow-hidden [background:var(--color-ink)] text-paper [&[data-contact-view='message']_.studio-visual]:w-full [&[data-contact-view='message']_.studio-visual]:delay-[0ms] [&[data-contact-view='message']_.studio-visual_img]:transform-[scale(1.08)] [&[data-contact-view='message']_.studio-content]:opacity-0 [&[data-contact-view='message']_.studio-content]:invisible [&[data-contact-view='message']_.studio-content]:transform-[translateX(32px)] [&[data-contact-view='message']_.studio-content]:pointer-events-none [&[data-contact-view='message']_.studio-content]:delay-[0ms,0ms,350ms] [&[data-contact-view='message']_.studio-editor]:[clip-path:inset(0)] [&[data-contact-view='message']_.studio-editor]:visible [&[data-contact-view='message']_.studio-editor]:pointer-events-auto [&[data-contact-view='message']_.studio-editor]:[transition:clip-path_650ms_cubic-bezier(.76,0,.24,1)_850ms,visibility_0s] [&[data-contact-view='message']_.dialog-heading]:opacity-100 [&[data-contact-view='message']_.dialog-heading]:transform-[translateY(0)] [&[data-contact-view='message']_.dialog-heading]:[transition:opacity_500ms_ease_var(--reveal-delay,1050ms),transform_650ms_cubic-bezier(.16,1,.3,1)_var(--reveal-delay,1050ms)] [&[data-contact-view='message']_.dialog-fields_>_label]:opacity-100 [&[data-contact-view='message']_.dialog-fields_>_label]:transform-[translateY(0)] [&[data-contact-view='message']_.dialog-fields_>_label]:[transition:opacity_500ms_ease_var(--reveal-delay,1050ms),transform_650ms_cubic-bezier(.16,1,.3,1)_var(--reveal-delay,1050ms)] [&[data-contact-view='message']_.studio-editor_form_>_.studio-button]:opacity-100 [&[data-contact-view='message']_.studio-editor_form_>_.studio-button]:transform-[translateY(0)] [&[data-contact-view='message']_.studio-editor_form_>_.studio-button]:[transition:opacity_500ms_ease_var(--reveal-delay,1050ms),transform_650ms_cubic-bezier(.16,1,.3,1)_var(--reveal-delay,1050ms)] motion-reduce:**:[transition:none]! motion-reduce:[&[data-contact-view='message']_*]:[transition:none]! max-[900px]:[--contact-banner:clamp(96px,20svh,180px)]" data-contact-view="details">
    <div class="studio-visual absolute inset-[0_auto_0_0] z-2 w-[50%] overflow-hidden [background:var(--color-brick)] [transition:width_800ms_cubic-bezier(.76,0,.24,1)_350ms] [&_img]:w-full [&_img]:h-full [&_img]:object-cover [&_img]:transform-[scale(1)] [&_img]:[transition:transform_1400ms_cubic-bezier(.22,1,.36,1)] max-[900px]:w-full max-[900px]:h-(--contact-banner)" aria-hidden="true">
      <Image src={contactPattern} widths={[600, 960, 1440, 1920]} width={1440} sizes="100vw" format="webp" alt="" loading="eager" fetchpriority="high" />
    </div>
    <section class="studio-content absolute top-0 w-[50%] h-full flex flex-col justify-center p-[clamp(76px,10dvh,110px)_clamp(24px,4.3vw,82px)_28px] right-0 z-1 [transition:opacity_300ms_ease_1000ms,transform_700ms_cubic-bezier(.22,1,.36,1)_850ms,visibility_0s_1000ms] focus:[outline:none] focus:[box-shadow:none] [&_h1]:[font:600_clamp(34px,3.6vw,56px)/1.05_var(--font-display)] [&_h1]:uppercase [@media((max-height:_700px))]:pt-19 [@media((max-height:_700px))]:pb-5 max-[900px]:w-full max-[900px]:top-(--contact-banner) max-[900px]:h-[calc(100%-var(--contact-banner))] max-[900px]:p-6 max-[900px]:[background:var(--color-ink)] max-[900px]:justify-center max-[900px]:[&_h1]:text-[clamp(30px,7vw,42px)] [@media((max-height:_550px))]:[&&]:pt-16.5 [@media((max-height:_550px))]:[&&]:pb-3 [@media((max-height:_550px))]:[&&]:[&_h1]:text-[30px] min-h-0 overflow-y-auto max-[900px]:justify-start max-[900px]:*:shrink-0 max-[900px]:pb-[max(24px,env(safe-area-inset-bottom))] [@media(max-height:600px)]:justify-start [@media(max-height:600px)]:*:shrink-0 max-[900px]:[&&&&]:pt-6 max-[900px]:[&&&&]:pb-[max(24px,env(safe-area-inset-bottom))]" data-contact-info aria-labelledby="contact-title" tabindex="-1">
      <h1 id="contact-title">Échangeons.</h1>
      <p class="studio-intro max-w-85 text-soft text-[14px] leading-[1.7] mt-5 [@media((max-height:_700px))]:mt-3.5 [@media((max-height:_700px))]:text-[13px] max-[900px]:mt-3 max-[900px]:text-[13px] max-[900px]:leading-[1.6] [@media((max-height:_550px))]:[&&]:mt-2.5 [@media((max-height:_550px))]:[&&]:text-[12px]">Une proposition de stage, un projet ou une question ? Parlons-en.</p>
      <a class="email-block relative block [background:var(--color-brick)] p-[24px_48px_24px_24px] mt-8 [transition:background_220ms] hover:[background:var(--color-brick)] [&_.block-label]:opacity-100 [&_.block-label]:mb-3 [&:hover_.email-arrow]:transform-[translateX(4px)] [@media((max-height:_700px))]:mt-5 [@media((max-height:_700px))]:py-4.5 max-[900px]:mt-5 max-[900px]:p-[18px_42px_18px_18px] [@media((max-height:_550px))]:[&&]:mt-3.5 [@media((max-height:_550px))]:[&&]:py-3.5 [@media((max-height:_550px))]:[&&]:[&_.block-label]:mb-1.5" href={`mailto:${site.email}`}>
        <span class="block-label block uppercase text-[10px] tracking-widest">E-mail</span>
        <span class="email-address text-[clamp(14px,1.25vw,20px)] wrap-anywhere">{site.email}</span>
        <svg class="email-arrow absolute right-5 top-[calc(50%-10px)] [transition:transform_220ms]" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" /></svg>
      </a>
      <div class="studio-coordinates grid grid-cols-[1fr_1fr] gap-2.5 mt-2.5">
        <div class="coordinate-block flex flex-col gap-3 p-[22px_20px] [background:var(--color-ink)] text-[13px] [&_.block-label]:text-soft [@media((max-height:_700px))]:py-4 max-[900px]:p-[16px_14px] max-[900px]:gap-2 max-[900px]:text-[12px] [@media((max-height:_550px))]:[&&]:py-3 [@media((max-height:_550px))]:[&&]:gap-1.5"><span class="block-label block uppercase text-[10px] tracking-widest">Téléphone</span><span>{site.phone}</span></div>
        <div class="coordinate-block flex flex-col gap-3 p-[22px_20px] [background:var(--color-ink)] text-[13px] [&_.block-label]:text-soft [@media((max-height:_700px))]:py-4 max-[900px]:p-[16px_14px] max-[900px]:gap-2 max-[900px]:text-[12px] [@media((max-height:_550px))]:[&&]:py-3 [@media((max-height:_550px))]:[&&]:gap-1.5"><span class="block-label block uppercase text-[10px] tracking-widest">Localisation</span><span>{site.location}</span></div>
      </div>
      <div class="studio-actions flex items-center flex-wrap gap-6 mt-6.5 [@media((max-height:_700px))]:mt-5 max-[900px]:mt-5 max-[900px]:gap-4 [@media((max-height:_550px))]:[&&]:mt-3">
        <button class="studio-button inline-flex items-center justify-between gap-7 min-h-11.5 h-auto p-[15px_20px] [border:0] rounded-none [background:var(--color-paper)] text-ink [box-shadow:none] [font:500_11px/1.2_var(--font-sans)] uppercase [transition:background_220ms] shrink-0 flex-nowrap select-none text-center align-middle outline-paper outline-offset-2 hover:[background:var(--color-paper)] [&_svg]:flex-[0_0_auto]" type="button" data-open-contact aria-expanded="false" aria-controls="contact-message">
          Écrire un message
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" /></svg>
        </button>
        {cvUrl && <a class="studio-cv text-[11px] uppercase hover:text-paper" href={cvUrl} target="_blank" rel="noopener noreferrer">Mon CV<span class="sr-only"> (nouvel onglet)</span></a>}
      </div>
      {site.socials.length > 0 && <nav class="studio-socials text-[11px] uppercase flex flex-wrap gap-4.5 mt-6 text-soft [&_a:hover]:text-paper max-[900px]:mt-4 [@media((max-height:_550px))]:[&&]:mt-3" aria-label="Réseaux professionnels">{site.socials.map((social) => <a href={social.url} target="_blank" rel="noopener noreferrer">{social.name}<span class="sr-only"> (nouvel onglet)</span></a>)}</nav>}
    </section>
    <section id="contact-message" class="studio-editor absolute top-0 w-[50%] h-full flex flex-col justify-center p-[clamp(76px,10dvh,110px)_clamp(24px,4.3vw,82px)_28px] left-0 z-3 [background:var(--color-ink)] [clip-path:inset(0_100%_0_0)] invisible pointer-events-none [transition:clip-path_500ms_cubic-bezier(.76,0,.24,1),visibility_0s_500ms] focus:[outline:none] focus:[box-shadow:none] [&_form_>_.studio-button]:opacity-0 [&_form_>_.studio-button]:transform-[translateY(22px)] [&_form_>_.studio-button]:[transition:opacity_180ms_ease,transform_300ms_ease] [&_form_>_.studio-button]:[--reveal-delay:1420ms] [&_form_>_.studio-button]:mt-6 [&_form_>_.studio-button]:[background:var(--color-brick)] [&_form_>_.studio-button]:text-paper [&_form_>_.studio-button:hover]:[background:var(--color-brick)] [@media((max-height:_700px))]:pt-19 [@media((max-height:_700px))]:pb-5 [@media((max-height:_700px))]:[&_form_>_.studio-button]:mt-4.5 max-[900px]:w-full max-[900px]:p-[76px_24px_24px] [@media((max-height:_550px))]:[&&]:pt-16.5 [@media((max-height:_550px))]:[&&]:pb-3 [@media((max-height:_550px))]:[&&]:[&_form_>_.studio-button]:mt-3 [@media((max-height:_450px))]:[&&&]:pt-14 [@media((max-height:_450px))]:[&&&]:pb-3 [@media((max-height:_450px))]:[&&&]:[&_.dialog-fields]:grid-cols-3 [@media((max-height:_450px))]:[&&&]:[&_.field-wide]:col-[2/-1] [@media((max-height:_450px))]:[&&&]:[&_.field-wide]:row-2 [@media((max-height:_450px))]:[&&&]:[&_textarea.studio-input]:h-13.5 [@media((max-height:_450px))]:[&&&]:[&_textarea.studio-input]:min-h-13.5 min-h-0 overflow-y-auto max-[900px]:[&&&&]:justify-start max-[900px]:[&&&&]:pt-22 max-[900px]:[&&&&]:pb-[max(24px,env(safe-area-inset-bottom))] max-[900px]:[&&&&]:*:shrink-0 max-[900px]:[&&&&]:[&_.dialog-fields]:grid-cols-2 max-[900px]:[&&&&]:[&_.field-wide]:col-span-full max-[900px]:[&&&&]:[&_.field-wide]:row-auto max-[400px]:[&&&&&]:[&_.dialog-fields]:grid-cols-1 [@media(max-height:600px)]:justify-start [@media(max-height:600px)]:*:shrink-0" data-contact-editor aria-labelledby="message-title" aria-hidden="true" inert tabindex="-1">
      <div class="dialog-heading opacity-0 transform-[translateY(22px)] [transition:opacity_180ms_ease,transform_300ms_ease] flex justify-start mb-6 [@media((max-height:_700px))]:mb-3 [@media((max-height:_550px))]:[&&]:mb-2">
        <h2 id="message-title" class="sr-only">Formulaire de contact</h2>
        <button class="editor-return inline-flex items-center gap-2 min-h-10 p-[8px_0] [background:transparent] text-soft text-[10px] uppercase hover:text-paper min-h-11" type="button" data-close-contact>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 12H5m6-6-6 6 6 6" stroke="currentColor" stroke-width="1.8" /></svg>
          Coordonnées
        </button>
      </div>
      <p id="contact-form-help" class="sr-only">Les champs marqués d’un astérisque sont obligatoires. Votre message sera transmis par e-mail à Melvyn Philippon.</p>
      <form data-contact-form data-endpoint={`https://formsubmit.co/ajax/${site.email}`} aria-describedby="contact-form-help" action={`https://formsubmit.co/${site.email}`} method="post">
        <input type="hidden" name="_subject" value="Contact depuis le portfolio — Melvyn Philippon" />
        <input type="hidden" name="_template" value="table" />
        <div class="hidden" aria-hidden="true"><label>Ne pas remplir<input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label></div>
        <div class="dialog-fields grid grid-cols-[1fr_1fr] gap-[18px_14px] [&_>_label]:opacity-0 [&_>_label]:transform-[translateY(22px)] [&_>_label]:[transition:opacity_180ms_ease,transform_300ms_ease] [&_>_label:nth-child(1)]:[--reveal-delay:1100ms] [&_>_label:nth-child(2)]:[--reveal-delay:1160ms] [&_>_label:nth-child(3)]:[--reveal-delay:1220ms] [&_>_label:nth-child(4)]:[--reveal-delay:1280ms] [&_>_label:nth-child(5)]:[--reveal-delay:1340ms] [&_label]:flex [&_label]:flex-col [&_label]:gap-2 [&_label]:min-w-0 [&_label]:text-[12px] [@media((max-height:_700px))]:gap-3 [@media((max-height:_700px))]:[&_label]:gap-1.5 [@media((max-height:_550px))]:[&&]:gap-[8px_12px] [@media((max-height:_550px))]:[&&]:[&_label]:text-[11px]">
          <label>Prénom*<input class="studio-input w-full max-w-none min-h-10.5 h-10.5 [border:0] rounded-none p-[10px_12px] [background:color-mix(in_srgb,var(--color-paper)_10%,transparent)] text-paper [font:400_14px/1.5_var(--font-sans)] [box-shadow:none] appearance-none align-middle shrink touch-manipulation [textarea&]:resize-none [textarea&]:h-[clamp(80px,15dvh,150px)] [textarea&]:min-h-20 [textarea&]:overflow-y-auto focus-visible:[outline:2px_solid_var(--color-paper)] focus-visible:outline-offset-2 [@media((max-height:_700px))]:min-h-9.5 [@media((max-height:_700px))]:h-9.5 [@media((max-height:_700px))]:py-2 [@media((max-height:_700px))]:text-[13px] [@media((max-height:_550px))]:[&&]:min-h-8.5 [@media((max-height:_550px))]:[&&]:h-8.5 [@media((max-height:_550px))]:[&&]:[textarea&]:min-h-16.25 [@media((max-height:_550px))]:[&&]:[textarea&]:h-16.25 [input&]:inline-flex [input&]:relative [input&]:whitespace-nowrap [input&]:items-center [input&]:gap-2 [select&]:inline-flex [select&]:relative [select&]:whitespace-nowrap [select&]:items-center [input&]:cursor-text [select&]:gap-1.5 [select&]:text-ellipsis [select&]:overflow-hidden focus:[outline:2px_solid_var(--color-paper)] focus:outline-offset-2 focus-visible:outline-paper max-[900px]:[&&&&&]:text-base max-[900px]:[&&&&&]:min-h-11 max-[900px]:[&&&&&:not(textarea)]:h-11 max-[900px]:[&&&&&:is(textarea)]:h-32 max-[900px]:[&&&&&:is(textarea)]:min-h-24 max-[900px]:[&&&&&]:py-2 pointer-coarse:[&&&&&&]:text-base pointer-coarse:[&&&&&&]:min-h-11 pointer-coarse:[&&&&&&:not(textarea)]:h-11 pointer-coarse:[&&&&&&]:py-2 pointer-coarse:[&&&&&&:is(textarea)]:h-32 pointer-coarse:[&&&&&&:is(textarea)]:min-h-24" type="text" name="prenom" autocomplete="given-name" required maxlength="100" /></label>
